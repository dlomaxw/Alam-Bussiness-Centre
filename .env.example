# Cloudflare D1 (lead database) - server only, never expose with NEXT_PUBLIC_
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# R2 object storage (reserved for brochure / floor-plan uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=

# Commercial terms - server only, gates the price reveal
LEASE_RATE_USD_PER_SQM_MONTH=15

# Public configuration
NEXT_PUBLIC_SITE_URL=https://www.alambusinesscenter.com
NEXT_PUBLIC_LEASING_PHONE=+256700000000
NEXT_PUBLIC_LEASING_PHONE_DISPLAY=+256 700 000 000
NEXT_PUBLIC_WHATSAPP_NUMBER=256700000000
NEXT_PUBLIC_PRESENTATION_URL=
NEXT_PUBLIC_LEASING_EMAIL=leasing@alambusinesscenter.com

# Analytics (leave blank to disable)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# CRM session signing key - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CRM_SESSION_SECRET=

# WhatsApp Cloud API webhook (optional).
# Leave blank and the webhook stays inactive; tap-throughs are still recorded.
# WHATSAPP_VERIFY_TOKEN is any random string you also paste into Meta.
# WHATSAPP_APP_SECRET is the Meta app secret, used to verify Meta signed the request.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
